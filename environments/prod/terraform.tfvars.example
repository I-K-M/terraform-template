environment = "prod"
aws_account_id = "123456789012"
aws_region = "eu-west-3"
availability_zone = "eu-west-3a"
enable_bastion = false
enable_nat_gateway = true
enable_observability = true
alert_email = "security-alerts@example.com" # Replace with a monitored mailbox; confirm SNS subscription.
# For real HA add multiple AZs, immutable builds and a recovery design first.
